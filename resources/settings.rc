#include "settings_ids.h"
#include <commctrl.h>
IDD_SETTINGS DIALOGEX 0, 0, 430, 382
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "CpuOverlay 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX "显示 / 隐藏快捷键", -1, 10, 6, 410, 48
    LTEXT "快捷键(&K)", -1, 20, 23, 65, 12
    CONTROL "", IDC_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 87, 20, 150, 15
    CONTROL "加上 Win 键", IDC_WINKEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 250, 22, 100, 13
    LTEXT "单击输入框后按下组合键；支持 F1–F11 或 Ctrl / Alt / Win 组合。", -1, 20, 39, 390, 11

    GROUPBOX "排列与屏幕位置", -1, 10, 60, 410, 103
    LTEXT "显示器(&M)", -1, 20, 79, 57, 12
    COMBOBOX IDC_MONITOR, 80, 76, 190, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "排列(&L)", -1, 282, 79, 42, 12
    COMBOBOX IDC_LAYOUT, 326, 76, 83, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "定位方式(&P)", -1, 20, 104, 58, 12
    COMBOBOX IDC_POSITION, 80, 101, 190, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "拖动定位(&D)…", IDC_PICK_POSITION, 282, 100, 127, 17
    LTEXT "左边距 X", -1, 20, 130, 48, 12
    EDITTEXT IDC_X, 70, 127, 58, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "上边距 Y", -1, 144, 130, 48, 12
    EDITTEXT IDC_Y, 194, 127, 58, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "预设留白", -1, 282, 130, 58, 12
    EDITTEXT IDC_MARGIN, 346, 127, 63, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "自定义坐标相对所选屏幕工作区左上角，超出边缘时自动收回。", -1, 20, 148, 390, 11

    GROUPBOX "文字外观", -1, 10, 169, 410, 100
    LTEXT "字体(&F)", -1, 20, 188, 45, 12
    COMBOBOX IDC_FONT, 70, 184, 222, 135, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "字号(磅)", -1, 307, 188, 49, 12
    EDITTEXT IDC_POINTS, 360, 185, 49, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "加粗", IDC_BOLD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 212, 46, 13
    CONTROL "斜体", IDC_ITALIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 212, 46, 13
    PUSHBUTTON "文字颜色…", IDC_CHOOSE_COLOR, 127, 209, 67, 17
    EDITTEXT IDC_COLOR, 200, 210, 72, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "不透明度 %", -1, 282, 213, 73, 12
    EDITTEXT IDC_OPACITY, 360, 210, 49, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "间距", -1, 20, 240, 40, 12
    EDITTEXT IDC_GAP, 70, 237, 40, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "描边宽度", -1, 127, 240, 64, 12
    EDITTEXT IDC_OUTLINE, 200, 237, 40, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "描边颜色…", IDC_CHOOSE_OUTLINE, 252, 236, 80, 17
    EDITTEXT IDC_OUTLINE_COLOR, 339, 237, 70, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "字号 8–96；间距 0–40；描边 0–6（0 表示关闭）；颜色支持 #RRGGBB。", -1, 20, 255, 390, 11

    GROUPBOX "外观预览", -1, 10, 275, 410, 58
    CONTROL "预览", IDC_PREVIEW, "Static", SS_OWNERDRAW, 20, 288, 389, 37
    LTEXT "预览不会保存。点击“应用”或“确定”保存配置。", IDC_SETTINGS_STATUS, 12, 338, 405, 13
    PUSHBUTTON "恢复默认", IDC_RESET, 10, 358, 67, 18
    PUSHBUTTON "桌面预览", IDC_DESKTOP_PREVIEW, 83, 358, 70, 18
    DEFPUSHBUTTON "确定", IDOK, 220, 358, 62, 18
    PUSHBUTTON "取消", IDCANCEL, 289, 358, 62, 18
    PUSHBUTTON "应用(&A)", IDC_APPLY, 358, 358, 62, 18
END
