#include "settings_ids.h"
#include <commctrl.h>
IDD_SETTINGS DIALOGEX 0, 0, 430, 585
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "CpuOverlay 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX "显示 / 隐藏快捷键", -1, 10, 6, 410, 48
    LTEXT "快捷键(&K)", -1, 20, 23, 65, 12
    CONTROL "", IDC_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 87, 20, 150, 15
    CONTROL "加上 Win 键", IDC_WINKEY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 250, 22, 100, 13
    LTEXT "单击输入框后按下组合键；支持 F1–F11 或 Ctrl / Alt / Win 组合。", -1, 20, 39, 390, 11

    GROUPBOX "显示内容", -1, 10, 60, 410, 124
    CONTROL "CPU 占用", IDC_METRIC_CPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 75, 95, 13
    CONTROL "CPU 频率", IDC_METRIC_FREQUENCY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 115, 75, 95, 13
    CONTROL "CPU 温度", IDC_METRIC_TEMPERATURE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 75, 95, 13
    CONTROL "CPU 功耗", IDC_METRIC_POWER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 305, 75, 100, 13
    CONTROL "内存占用", IDC_METRIC_MEMORY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 94, 95, 13
    CONTROL "显卡占用", IDC_METRIC_GPU, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 115, 94, 95, 13
    CONTROL "键盘电量", IDC_METRIC_KEYBOARD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 94, 95, 13
    CONTROL "鼠标电量", IDC_METRIC_MOUSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 305, 94, 100, 13
    CONTROL "显卡型号", IDC_METRIC_GPU_NAME, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 113, 95, 13
    CONTROL "显卡温度", IDC_METRIC_GPU_TEMPERATURE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 115, 113, 95, 13
    CONTROL "显卡频率", IDC_METRIC_GPU_FREQUENCY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 210, 113, 95, 13
    CONTROL "显卡功耗", IDC_METRIC_GPU_POWER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 305, 113, 100, 13
    CONTROL "显存用量", IDC_METRIC_GPU_MEMORY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 132, 95, 13
    CONTROL "前台帧率 FPS", IDC_METRIC_FPS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 115, 132, 105, 13
    CONTROL "1% Low 帧率", IDC_METRIC_LOW_FPS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 225, 132, 100, 13
    PUSHBUTTON "调整显示顺序…", IDC_EDIT_ORDER, 250, 151, 159, 17
    PUSHBUTTON "自定义显示名称…", IDC_EDIT_NAMES, 20, 151, 190, 17
    CONTROL "启用乔思伯水泵温度数显", IDC_PUMP_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 170, 225, 13

    GROUPBOX "排列与屏幕位置", -1, 10, 190, 410, 103
    LTEXT "显示器(&M)", -1, 20, 209, 57, 12
    COMBOBOX IDC_MONITOR, 80, 206, 190, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "排列(&L)", -1, 282, 209, 42, 12
    COMBOBOX IDC_LAYOUT, 326, 206, 83, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "定位方式(&P)", -1, 20, 234, 58, 12
    COMBOBOX IDC_POSITION, 80, 231, 190, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "拖动定位(&D)…", IDC_PICK_POSITION, 282, 230, 127, 17
    LTEXT "左边距 X", -1, 20, 260, 48, 12
    EDITTEXT IDC_X, 70, 257, 58, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "上边距 Y", -1, 144, 260, 48, 12
    EDITTEXT IDC_Y, 194, 257, 58, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "预设留白", -1, 282, 260, 58, 12
    EDITTEXT IDC_MARGIN, 346, 257, 63, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "自定义坐标相对所选屏幕工作区左上角，超出边缘时自动收回。", -1, 20, 278, 390, 11

    GROUPBOX "文字外观与刷新", -1, 10, 299, 410, 124
    LTEXT "字体(&F)", -1, 20, 318, 45, 12
    COMBOBOX IDC_FONT, 70, 314, 222, 135, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "字号(磅)", -1, 307, 318, 49, 12
    EDITTEXT IDC_POINTS, 360, 315, 49, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "加粗", IDC_BOLD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 342, 46, 13
    CONTROL "斜体", IDC_ITALIC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 72, 342, 46, 13
    PUSHBUTTON "文字颜色…", IDC_CHOOSE_COLOR, 127, 339, 67, 17
    EDITTEXT IDC_COLOR, 200, 340, 72, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "不透明度 %", -1, 282, 343, 73, 12
    EDITTEXT IDC_OPACITY, 360, 340, 49, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "项目间距", -1, 20, 370, 45, 12
    EDITTEXT IDC_GAP, 70, 367, 40, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "描边宽度", -1, 127, 370, 64, 12
    EDITTEXT IDC_OUTLINE, 200, 367, 40, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "描边颜色…", IDC_CHOOSE_OUTLINE, 252, 366, 80, 17
    EDITTEXT IDC_OUTLINE_COLOR, 339, 367, 70, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "标签与数值间距", -1, 20, 391, 103, 12
    EDITTEXT IDC_VALUE_GAP, 127, 388, 50, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "信息刷新 (ms)", -1, 190, 391, 105, 12
    EDITTEXT IDC_REFRESH_INTERVAL, 300, 388, 109, 15, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "字号 8–96；间距 0–40；刷新 200–5000ms；描边 0–6；颜色 #RRGGBB。", -1, 20, 409, 390, 11

    GROUPBOX "应用内显示（内置，与桌面显示互斥）", -1, 10, 429, 410, 43
    CONTROL "启用", IDC_GAME_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 443, 50, 13
    CONTROL "D3D11", IDC_GAME_D3D11, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 82, 443, 70, 13
    CONTROL "D3D12", IDC_GAME_D3D12, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 164, 443, 70, 13
    CONTROL "OpenGL", IDC_GAME_OPENGL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 246, 443, 70, 13
    CONTROL "Vulkan", IDC_GAME_VULKAN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 328, 443, 80, 13
    LTEXT "Vulkan 游戏请在 CpuOverlay 之后启动。", IDC_GAME_STATUS, 20, 459, 292, 11
    PUSHBUTTON "应用排除...", IDC_GAME_APPS, 320, 456, 88, 14

    GROUPBOX "外观预览", -1, 10, 478, 410, 58
    CONTROL "预览", IDC_PREVIEW, "Static", SS_OWNERDRAW, 20, 491, 389, 37
    LTEXT "预览不会保存。点击“应用”或“确定”保存配置。", IDC_SETTINGS_STATUS, 12, 541, 405, 13
    PUSHBUTTON "恢复默认", IDC_RESET, 10, 561, 67, 18
    PUSHBUTTON "桌面预览", IDC_DESKTOP_PREVIEW, 83, 561, 70, 18
    DEFPUSHBUTTON "确定", IDOK, 220, 561, 62, 18
    PUSHBUTTON "取消", IDCANCEL, 289, 561, 62, 18
    PUSHBUTTON "应用(&A)", IDC_APPLY, 358, 561, 62, 18
END

IDD_GAME_APPS DIALOGEX 0, 0, 360, 286
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "应用内显示排除"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "勾选后不在该应用内部叠加，桌面顶部监控仍正常显示。", -1, 12, 9, 336, 14
    LTEXT "列出运行中、曾接入及已排除的应用；返回主设置后应用保存。", -1, 12, 25, 336, 14
    CONTROL "", IDC_APP_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 44, 336, 192
    PUSHBUTTON "添加 EXE...", IDC_APP_ADD, 12, 243, 86, 18
    PUSHBUTTON "刷新列表", IDC_APP_REFRESH, 105, 243, 76, 18
    DEFPUSHBUTTON "确定", IDOK, 210, 262, 62, 18
    PUSHBUTTON "取消", IDCANCEL, 286, 262, 62, 18
END

IDD_METRIC_NAMES DIALOGEX 0, 0, 350, 350
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自定义显示名称"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "修改浮窗冒号前的名称，每项 1–32 个字符。", -1, 12, 9, 326, 12
    LTEXT "返回主设置后，点击“应用”或“确定”保存。", -1, 12, 22, 326, 12
    LTEXT "CPU 占用", -1, 16, 41, 112, 12
    EDITTEXT IDC_LABEL_CPU, 132, 38, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "CPU 频率", -1, 16, 59, 112, 12
    EDITTEXT IDC_LABEL_FREQUENCY, 132, 56, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "CPU 温度", -1, 16, 77, 112, 12
    EDITTEXT IDC_LABEL_TEMPERATURE, 132, 74, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "CPU 功耗", -1, 16, 95, 112, 12
    EDITTEXT IDC_LABEL_POWER, 132, 92, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "内存占用", -1, 16, 113, 112, 12
    EDITTEXT IDC_LABEL_MEMORY, 132, 110, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显卡占用", -1, 16, 131, 112, 12
    EDITTEXT IDC_LABEL_GPU, 132, 128, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "键盘电量", -1, 16, 149, 112, 12
    EDITTEXT IDC_LABEL_KEYBOARD, 132, 146, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "鼠标电量", -1, 16, 167, 112, 12
    EDITTEXT IDC_LABEL_MOUSE, 132, 164, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显卡型号", -1, 16, 185, 112, 12
    EDITTEXT IDC_LABEL_GPU_NAME, 132, 182, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显卡温度", -1, 16, 203, 112, 12
    EDITTEXT IDC_LABEL_GPU_TEMPERATURE, 132, 200, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显卡频率", -1, 16, 221, 112, 12
    EDITTEXT IDC_LABEL_GPU_FREQUENCY, 132, 218, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显卡功耗", -1, 16, 239, 112, 12
    EDITTEXT IDC_LABEL_GPU_POWER, 132, 236, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "显存用量", -1, 16, 257, 112, 12
    EDITTEXT IDC_LABEL_GPU_MEMORY, 132, 254, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "前台帧率 FPS", -1, 16, 275, 112, 12
    EDITTEXT IDC_LABEL_FPS, 132, 272, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "1% Low 帧率", -1, 16, 293, 112, 12
    EDITTEXT IDC_LABEL_LOW_FPS, 132, 290, 202, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "恢复默认名称", IDC_NAMES_RESET, 12, 325, 100, 18
    DEFPUSHBUTTON "确定", IDOK, 196, 325, 66, 18
    PUSHBUTTON "取消", IDCANCEL, 272, 325, 66, 18
END

IDD_METRIC_ORDER DIALOGEX 0, 0, 320, 284
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "调整显示顺序"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "选中指标后上移或下移；横向和纵向显示均使用此顺序。", -1, 10, 9, 300, 13
    LISTBOX IDC_ORDER_LIST, 10, 28, 228, 212, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "上移(&U)", IDC_ORDER_UP, 248, 28, 62, 19
    PUSHBUTTON "下移(&D)", IDC_ORDER_DOWN, 248, 54, 62, 19
    PUSHBUTTON "默认顺序", IDC_ORDER_RESET, 248, 88, 62, 19
    LTEXT "未勾选的指标保留位置。返回设置后点击“应用”或“确定”保存。", -1, 10, 246, 300, 13
    DEFPUSHBUTTON "确定", IDOK, 176, 264, 62, 18
    PUSHBUTTON "取消", IDCANCEL, 248, 264, 62, 18
END
